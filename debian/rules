	    >> debian/tests/control.new < debian/tests/control.in
	# otherwise Architecture: is empty (and empty means "any" in autopgktest,
	# cf. https://salsa.debian.org/ci-team/autopkgtest/-/blob/master/lib/testdesc.py#L546)
