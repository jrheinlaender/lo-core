	done
	for i in $(ARCH_INDEP_PACKAGES); do \
		if [ -e debian/$$i.bug-control ]; then \
			if grep -q "^report-with:" debian/$$i.bug-control; then \
				extra_packages=`grep "^report-with:" debian/$$i.bug-control | sed -e "s/^report-with: //"`; \
