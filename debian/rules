		if [ "$$iso" = "en-US" ]; then pkg=common; \
		elif [ "$$iso" = "bn-IN" ]; then pkg=l10n-bn; \
		elif [ "$$iso" = "ca-valencia" ]; then pkg=l10n-ca; \
		elif [ "$$iso" = "sr-Latn" ]; then pkg=l10n-sr; \
		elif [ "$$iso" = "kmr-Latn" ]; then pkg=l10n-kmr; \
